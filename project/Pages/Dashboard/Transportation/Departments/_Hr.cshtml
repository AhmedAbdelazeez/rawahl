@model project.Pages.IndexModel

<div id="grid-support-hr" class="hidden">
    <!-- 1. Employee Retention Rate -->
    <div id="card-hr-ret" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-hr-ret-label">نسبة استبقاء الموظفين</span>
            <span id="flag-hr-ret" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-hr-ret">--%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-hr-ret">90%</span></span>
        </div>
    </div>

    <!-- 2. Saudization Rate -->
    <div id="card-hr-saudization" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-hr-saudization-label">نسبة التوطين والسعودة</span>
            <span id="flag-hr-saudization" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-hr-saudization">--%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-hr-saudization">35%</span></span>
        </div>
    </div>

    <!-- 3. Total Employee Count -->
    <div id="card-hr-count" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-hr-count-label">إجمالي عدد الموظفين</span>
            <span id="flag-hr-count" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-hr-count">--</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-hr-count">20</span></span>
        </div>
    </div>

    <!-- 4. Average Salary -->
    <div id="card-hr-growth" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-hr-growth-label">متوسط رواتب الموظفين</span>
            <span id="flag-hr-growth" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-hr-growth">--</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-hr-growth">9,000 SAR</span></span>
        </div>
    </div>

    <!-- 5. Average Assigned Tasks per Employee -->
    <div id="card-hr-absence" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-hr-absence-label">متوسط المهام لكل موظف</span>
            <span id="flag-hr-absence" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-hr-absence">--</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-hr-absence">4.0</span></span>
        </div>
    </div>

    <!-- 6. Average Employee Rating -->
    <div id="card-hr-training" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-hr-training-label">متوسط تقييم أداء الموظفين</span>
            <span id="flag-hr-training" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-hr-training">--</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-hr-training">4.0</span></span>
        </div>
    </div>

    <!-- 7. Average Evaluation Score -->
    <div id="card-hr-appraisal" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-hr-appraisal-label">متوسط نتائج التقييمات</span>
            <span id="flag-hr-appraisal" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-hr-appraisal">--%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-hr-appraisal">80%</span></span>
        </div>
    </div>
</div>
