@model project.Pages.IndexModel

<!-- Maintenance Department - Workshop Analysis
     8 indicators, every one of them read off the ERP's approved "Internal work orders" sheet
     (رقم امر العمل / رقم الحافلة / العداد / وصف العطل / تاريخ وساعة الدخول والخروج / أربعة فنيين /
     الحالة / المشرف / ملاحظات). Spare-parts cost and the breakdown-location breakdown were removed:
     the approved sheet carries neither a parts column nor a location column, so both were reporting
     figures no uploaded file actually supports. -->

<!-- 1. إجمالي أوامر العمل -->
<div id="card-dm-total" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">إجمالي أوامر العمل</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">سجل الورشة</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-total">--</span>
    </div>
</div>

<!-- 2. أوامر العمل المكتملة + نسبة الإنجاز -->
<div id="card-dm-completed" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">أوامر العمل المكتملة</span>
        <span id="flag-dm-completion" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-completed">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">نسبة الإنجاز: <span id="val-dm-completion-rate">--</span></span>
    </div>
</div>

<!-- 3. متوسط زمن الإصلاح -->
<div id="card-dm-mttr" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">متوسط زمن الإصلاح (MTTR)</span>
        <span id="flag-dm-mttr" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-mttr">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: 3.0 ساعات أو أقل</span>
    </div>
</div>

<!-- 4. أوامر متوقفة على قطع غيار -->
<div id="card-dm-waiting-parts" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">متوقفة على قطع غيار</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">سجل الورشة</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-waiting-parts">--</span>
    </div>
</div>

<!-- 5. أوامر جاري العمل عليها -->
<div id="card-dm-in-progress" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">جاري العمل عليها</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-sky-50 text-sky-700 border border-sky-200">سجل الورشة</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-in-progress">--</span>
    </div>
</div>

<!-- 6. نسبة الأعمال المتراكمة -->
<div id="card-dm-backlog" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">نسبة الأعمال المتراكمة</span>
        <span id="flag-dm-backlog" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-backlog">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">الحد الأقصى المستهدف: 10%</span>
    </div>
</div>

<!-- 7. الحافلات التي دخلت الورشة -->
<div id="card-dm-vehicles" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">حافلات دخلت الورشة</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 border border-violet-200">سجل الورشة</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-vehicles">--</span>
    </div>
</div>

<!-- 8. الفنيون المشاركون -->
<div id="card-dm-technicians" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">الفنيون المشاركون</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200">سجل الورشة</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-technicians">--</span>
    </div>
</div>

<!-- Top breakdown buses + work orders table - a single card- wrapper so showView()'s generic card
     mover (which only picks up elements whose id starts with "card-") relocates the whole block
     into #sector-kpis-grid together, same as the 8 KPI cards above. -->
<div id="card-dm-workorders" class="col-span-full grid grid-cols-1 gap-5">
    <div class="glass-card p-5 rounded-2xl">
        <h3 class="text-sm font-black mb-3 text-slate-800"><i class="fa-solid fa-bus text-[#b0841a]"></i> أكثر الحافلات تكرارًا للأعطال</h3>
        <div id="dm-top-breakdowns" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            <span class="text-xs text-slate-400 font-bold">جاري التحميل...</span>
        </div>
    </div>

    <div class="glass-card p-5 rounded-2xl flex flex-wrap gap-3 items-end">
        <div>
            <label class="text-[10px] font-bold text-slate-500 block mb-1">من تاريخ</label>
            <input type="date" id="dm-wo-from" class="border border-slate-200 rounded-lg px-3 py-2 text-xs" />
        </div>
        <div>
            <label class="text-[10px] font-bold text-slate-500 block mb-1">إلى تاريخ</label>
            <input type="date" id="dm-wo-to" class="border border-slate-200 rounded-lg px-3 py-2 text-xs" />
        </div>
        <button id="dm-wo-filter-apply" class="bg-slate-800 hover:bg-slate-700 text-white text-xs font-black px-4 py-2 rounded-lg">تطبيق الفلتر</button>
        <button id="dm-wo-filter-reset" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-4 py-2 rounded-lg">إعادة تعيين</button>
    </div>

    <div class="glass-card rounded-2xl overflow-hidden">
        <table class="w-full text-xs">
            <thead class="bg-slate-50 text-slate-500 font-black">
                <tr>
                    <td class="p-3">رقم أمر العمل</td>
                    <td class="p-3">رقم الحافلة</td>
                    <td class="p-3">التاريخ</td>
                    <td class="p-3">العداد</td>
                    <td class="p-3">وصف العطل</td>
                    <td class="p-3">الفنيون</td>
                    <td class="p-3">الحالة</td>
                </tr>
            </thead>
            <tbody id="dm-wo-table-body"></tbody>
        </table>
        <div class="flex justify-between items-center p-4 border-t border-slate-100">
            <span class="text-xs font-bold text-slate-500" id="dm-wo-page-info">--</span>
            <div class="flex gap-2">
                <button id="dm-wo-prev" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-3 py-1.5 rounded-lg">السابق</button>
                <button id="dm-wo-next" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-3 py-1.5 rounded-lg">التالي</button>
            </div>
        </div>
    </div>
</div>
