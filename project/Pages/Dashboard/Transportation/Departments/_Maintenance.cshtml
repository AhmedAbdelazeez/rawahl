@model project.Pages.IndexModel

<!-- Maintenance Department KPI Cards -->

<!-- 1. Mean Time To Repair -->
<div id="card-dm-mttr" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">متوسط زمن الإصلاح (MTTR)</span>
        <span id="flag-dm-mttr" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-mttr">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: 3.0 ساعات أو أقل</span>
    </div>
</div>

<!-- 2. Total Breakdowns -->
<div id="card-dm-breakdowns" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">إجمالي الأعطال المسجلة</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">سجل الورشة</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-breakdowns">--</span>
    </div>
</div>

<!-- 3. Fleet Availability Rate -->
<div id="card-dm-availability" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">نسبة جاهزية الأسطول</span>
        <span id="flag-dm-availability" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-availability">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: 90%</span>
    </div>
</div>

<!-- 4. Total Spare Parts Cost -->
<div id="card-dm-parts-cost" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">تكلفة قطع الغيار</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">تراكمي</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-parts-cost">--</span>
    </div>
</div>

<!-- 5. Maintenance Backlog Rate -->
<div id="card-dm-backlog" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">نسبة الأعطال المتراكمة</span>
        <span id="flag-dm-backlog" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-backlog">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">الحد الأقصى المستهدف: 10%</span>
    </div>
</div>

<!-- 6. Active Buses Under Maintenance Rate -->
<div id="card-dm-active-rate" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">نسبة الحافلات قيد الصيانة حاليًا</span>
        <span id="flag-dm-active-rate" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-dm-active-rate">--</span>
    </div>
</div>

<!-- Top Breakdown Buses + Work Orders table - a single card- wrapper so showView()'s generic
     card mover (which only picks up elements whose id starts with "card-") relocates the whole
     block into #sector-kpis-grid together, same as the 6 KPI cards above. -->
<div id="card-dm-workorders" class="col-span-full grid grid-cols-1 gap-5">
    <div class="glass-card p-5 rounded-2xl">
        <h3 class="text-sm font-black mb-3 text-slate-800"><i class="fa-solid fa-location-dot text-[#b0841a]"></i> أكثر المواقع تكرارًا للأعطال (من تقارير الفروع)</h3>
        <div id="dm-top-breakdowns" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            <span class="text-xs text-slate-400 font-bold">جاري التحميل...</span>
        </div>
    </div>

    <div class="glass-card p-5 rounded-2xl flex flex-wrap gap-3 items-end">
        <div>
            <label class="text-[10px] font-bold text-slate-500 block mb-1">من تاريخ</label>
            <input type="date" id="dm-wo-from" class="border border-slate-200 rounded-lg px-3 py-2 text-xs" />
        </div>
        <div>
            <label class="text-[10px] font-bold text-slate-500 block mb-1">إلى تاريخ</label>
            <input type="date" id="dm-wo-to" class="border border-slate-200 rounded-lg px-3 py-2 text-xs" />
        </div>
        <button id="dm-wo-filter-apply" class="bg-slate-800 hover:bg-slate-700 text-white text-xs font-black px-4 py-2 rounded-lg">تطبيق الفلتر</button>
        <button id="dm-wo-filter-reset" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-4 py-2 rounded-lg">إعادة تعيين</button>
    </div>

    <div class="glass-card rounded-2xl overflow-hidden">
        <table class="w-full text-xs">
            <thead class="bg-slate-50 text-slate-500 font-black">
                <tr>
                    <td class="p-3">رقم اللوحة</td>
                    <td class="p-3">التاريخ</td>
                    <td class="p-3">العداد</td>
                    <td class="p-3">وصف العطل</td>
                    <td class="p-3">الفني</td>
                    <td class="p-3">الحالة</td>
                </tr>
            </thead>
            <tbody id="dm-wo-table-body"></tbody>
        </table>
        <div class="flex justify-between items-center p-4 border-t border-slate-100">
            <span class="text-xs font-bold text-slate-500" id="dm-wo-page-info">--</span>
            <div class="flex gap-2">
                <button id="dm-wo-prev" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-3 py-1.5 rounded-lg">السابق</button>
                <button id="dm-wo-next" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-3 py-1.5 rounded-lg">التالي</button>
            </div>
        </div>
    </div>
</div>
