@model project.Pages.IndexModel

<!-- Fleet Department KPI Cards (10 Clean KPIs) -->

<!-- 1. Total Fleet Vehicles (إجمالي حافلات الأسطول) -->
<div id="card-fleet-total" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-total-title">إجمالي حافلات الأسطول</span>
        <span id="flag-fleet-total" class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">معتمد</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-total">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">السعة الإجمالية: <span id="val-fleet-total-capacity">--</span></span>
    </div>
</div>

<!-- 2. Ready Vehicles (الحافلات الجاهزة للتشغيل) -->
<div id="card-fleet-available" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-available-title">الحافلات الجاهزة للتشغيل</span>
        <span id="flag-fleet-available" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-available">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">الاحتياط الفوري: جاهزة</span>
    </div>
</div>

<!-- 3. Active Vehicles (الحافلات النشطة بالخدمة) -->
<div id="card-fleet-active" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-active-title">الحافلات النشطة بالخدمة</span>
        <span id="flag-fleet-active" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-active">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">معدل التشغيل المستهدف: 80%</span>
    </div>
</div>

<!-- 4. Vehicles in Maintenance (الحافلات قيد الصيانة) -->
<div id="card-fleet-maintenance" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-maintenance-title">الحافلات قيد الصيانة</span>
        <span id="flag-fleet-maintenance" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-maintenance">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">الحد الأقصى المسموح: 10%</span>
    </div>
</div>

<!-- 5. Inactive / Out of Service Vehicles (الحافلات الخارجة عن الخدمة) -->
<div id="card-fleet-inactive" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-inactive-title">الحافلات الخارجة عن الخدمة</span>
        <span id="flag-fleet-inactive" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-inactive">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">مستبعدة مؤقتاً</span>
    </div>
</div>

<!-- 6. Fleet Utilization Rate (معدل استغلال الأسطول) -->
<div id="card-fleet-util" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-util-title">معدل استغلال الأسطول</span>
        <span id="flag-fleet-util" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-util">@Model.FleetUtil%</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: 80%</span>
    </div>
</div>

<!-- 7. Fleet Availability Rate (نسبة جاهزية الأسطول) -->
<div id="card-fleet-ready" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-ready-title">نسبة جاهزية الأسطول</span>
        <span id="flag-fleet-ready" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-ready">@Model.FleetReady%</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: 90%</span>
    </div>
</div>

<!-- 8. Total Registered Trips (إجمالي الرحلات المسجلة) -->
<div id="card-fleet-total-trips" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-total-trips-title">إجمالي الرحلات المسجلة</span>
        <span id="flag-fleet-total-trips" class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">الرحلات</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-total-trips">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">سجل التشغيل</span>
    </div>
</div>

<!-- 9. Completed Trips (الرحلات المكتملة بنجاح) -->
<div id="card-fleet-completed-trips" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-completed-trips-title">الرحلات المكتملة بنجاح</span>
        <span id="flag-fleet-completed-trips" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-completed-trips">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">نسبة الإتمام المجدولة</span>
    </div>
</div>

<!-- 10. Fleet Breakdown/Maintenance Rate (معدل صيانة الحافلات) -->
<div id="card-fleet-maint-rate" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-maint-rate-title">معدل صيانة الحافلات</span>
        <span id="flag-fleet-maint-rate" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-maint-rate">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">الحد الأقصى: 5%</span>
    </div>
</div>

<!-- 11. Mean Time To Repair (متوسط وقت الإصلاح) -->
<div id="card-fleet-mttr" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-mttr-title">متوسط وقت الإصلاح (MTTR)</span>
        <span id="flag-fleet-mttr" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-mttr">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: 3.0 ساعات</span>
    </div>
</div>

<!-- 12. Total Spare Parts Cost (إجمالي تكلفة قطع الغيار) -->
<div id="card-fleet-parts-cost" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-fleet-parts-cost-title">تكلفة قطع غيار الصيانة</span>
        <span id="flag-fleet-parts-cost" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-parts-cost">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المخازن والصيانة</span>
    </div>
</div>

<!-- 13. Total Seating Capacity (إجمالي السعة المقعدية) -->
<div id="card-fleet-total-seating" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">إجمالي السعة المقعدية للأسطول</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">من ملف الأسطول</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-total-seating">--</span>
    </div>
</div>

<!-- 14. Average Bus Age (متوسط عمر الحافلة) -->
<div id="card-fleet-avg-age" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">متوسط عمر الحافلة</span>
        <span id="flag-fleet-avg-age" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-avg-age">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: 5 سنوات أو أقل</span>
    </div>
</div>

<!-- 15. Fleet Modernization Rate (معدل حداثة الأسطول) -->
<div id="card-fleet-modernization" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">معدل حداثة الأسطول</span>
        <span id="flag-fleet-modernization" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-modernization">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">حافلات عمرها 5 سنوات فأقل</span>
    </div>
</div>

<!-- 16. Bus Type Variety (تنوع أنواع الحافلات) -->
<div id="card-fleet-type-variety" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">تنوع أنواع الحافلات</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">من ملف الأسطول</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-type-variety">--</span>
    </div>
</div>

<!-- 17. Average Capacity per Bus (متوسط سعة الحافلة) -->
<div id="card-fleet-avg-capacity" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800">متوسط سعة الحافلة</span>
        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">من ملف الأسطول</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-fleet-avg-capacity">--</span>
    </div>
</div>
