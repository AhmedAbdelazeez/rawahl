@model project.Pages.IndexModel

<!-- Strategy & Performance Department KPI Cards -->
<div id="grid-strategy-gov" class="hidden">
    <!-- 1. Strategic Goals -->
    <div id="card-strat-goals" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-strat-goals-label">تحقيق أهداف الاستراتيجية والتوسع</span>
            <span id="flag-strat-goals" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-strat-goals">@Model.StrategicGoals%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-strat-goals">--</span></span>
        </div>
    </div>

    <!-- 2. Strategic Initiatives -->
    <div id="card-strat-init" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-strat-init-label">معدل إنجاز مبادرات مكتب PMO</span>
            <span id="flag-strat-init" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-strat-init">@Model.StrategicInitiatives%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-strat-init">--</span></span>
        </div>
    </div>

    <!-- 3. Risk Handling -->
    <div id="card-risk-handling" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-risk-handling-label">نسبة معالجة المخاطر المؤسسية</span>
            <span id="flag-risk-handling" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-risk-handling">@Model.RiskHandling%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-risk-handling">--</span></span>
        </div>
    </div>

    <!-- 4. Governance Maturity -->
    <div id="card-gov-maturity" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-gov-maturity-label">مستوى تطبيق حوكمة الشركات</span>
            <span id="flag-gov-maturity" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-gov-maturity">@Model.GovMaturity%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-gov-maturity">--</span></span>
        </div>
    </div>

    <!-- 5. Strategic Goals Achieve -->
    <div id="card-strat-goals-achieve" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-strat-goals-achieve-label">نسبة تحقيق الأهداف الاستراتيجية الموحدة</span>
            <span id="flag-strat-goals-achieve" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-strat-goals-achieve">@Model.StratGoalsAchieve%</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-strat-goals-achieve">--</span></span>
        </div>
    </div>

    <!-- 6. Strategic Milestones -->
    <div id="card-strat-milestones" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-strat-milestones-label">إنجاز معالم مبادرات PMO بالوقت</span>
            <span id="flag-strat-milestones" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-strat-milestones">--</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-strat-milestones">--</span></span>
        </div>
    </div>

    <!-- 7. Strategic Budget -->
    <div id="card-strat-budget" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[11px] font-black text-slate-800" data-i18n="val-strat-budget-label">كفاءة استغلال الموازنة الاستراتيجية</span>
            <span id="flag-strat-budget" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-strat-budget">--</span>
            <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-strat-budget">--</span></span>
        </div>
    </div>
</div>
