@model project.Pages.IndexModel

<!-- ================= إدارة الامتثال (Compliance Department View) =================
     8 basic indicators, every one of them a direct count/sum over the violations log uploaded
     through the ERP's Compliance template (وصف المخالفة / الإدارة / التصنيف / درجة الخطورة /
     الحالة / تاريخ الرصد / تاريخ الإغلاق / قيمة الغرامة). Metrics that used to sit here and
     depended on data that sheet doesn't carry - contract-item compliance, per-department policy
     flags, internal-audit pass rates, continuous-improvement progress - were removed rather than
     left showing seeded figures.
================================================================================== -->
<div id="view-dept-compliance" class="view-container hidden">
    <section class="mb-6" data-aos="fade-up">
        <div class="bg-white rounded-3xl p-6 text-slate-800 border border-[#b0841a]/30 relative overflow-hidden">
            <div class="absolute -right-24 -top-24 w-64 h-64 bg-[#b0841a]/5 rounded-full blur-3xl"></div>
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 relative z-10 text-start">
                <div>
                    <span class="bg-[#b0841a]/10 text-[#b0841a] text-[10px] px-3.5 py-1.5 rounded-full font-bold border border-[#b0841a]/20">بوابة الحوكمة والرقابة</span>
                    <h2 class="text-lg font-black mt-2 text-slate-800" data-i18n="dept-compliance-title">إدارة الامتثال</h2>
                    <p class="text-slate-500 text-xs leading-relaxed font-semibold mt-1">مؤشرات محسوبة مباشرة من سجل المخالفات المرفوع عبر نموذج إدارة الامتثال في نظام ERP.</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="window.PortalIntegration.refreshComplianceKpis()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-black rounded-xl text-slate-800 flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-rotate"></i>
                        <span>تحديث المؤشرات</span>
                    </button>
                    <button id="compliance-back-btn" onclick="showView('transportation-sector')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-black rounded-xl text-slate-800 flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-arrow-right"></i>
                        <span data-i18n="btn-back-depts">العودة للنقل التخصصي</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- 8 Compliance KPI Cards -->
    <div id="grid-compliance" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 text-start" data-aos="fade-up">
        <!-- 1. إجمالي المخالفات المسجلة -->
        <div id="card-comp-total-violations" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-total-violations">إجمالي المخالفات المسجلة</span>
                <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-50 text-slate-600 border border-slate-200">سجل المخالفات</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-total-violations">--</span>
            </div>
        </div>

        <!-- 2. المخالفات المفتوحة -->
        <div id="card-comp-open-violations" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-open-violations">المخالفات المفتوحة</span>
                <span id="flag-comp-open-violations" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-open-violations">--</span>
                <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-comp-open-violations">0</span></span>
            </div>
        </div>

        <!-- 3. المخالفات المغلقة -->
        <div id="card-comp-closed-violations" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-closed-violations">المخالفات المغلقة</span>
                <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">سجل المخالفات</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-closed-violations">--</span>
            </div>
        </div>

        <!-- 4. نسبة إغلاق المخالفات -->
        <div id="card-comp-closure-rate" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-closure-rate">نسبة إغلاق المخالفات</span>
                <span id="flag-comp-closure-rate" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-closure-rate">--</span>
                <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-comp-closure-rate">95%</span></span>
            </div>
        </div>

        <!-- 5. متوسط زمن معالجة المخالفة -->
        <div id="card-comp-resolution-time" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-resolution-time">متوسط زمن معالجة المخالفة</span>
                <span id="flag-comp-resolution-time" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-resolution-time">--</span>
                <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-comp-resolution-time">5 أيام</span></span>
            </div>
        </div>

        <!-- 6. عدد المخالفات الحرجة -->
        <div id="card-comp-critical-violations" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-critical-violations">عدد المخالفات الحرجة</span>
                <span id="flag-comp-critical-violations" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-critical-violations">--</span>
                <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-comp-critical-violations">0</span></span>
            </div>
        </div>

        <!-- 7. إجمالي قيمة الغرامات -->
        <div id="card-comp-total-fines" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-total-fines">إجمالي قيمة الغرامات</span>
                <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200">سجل المخالفات</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-total-fines">--</span>
            </div>
        </div>

        <!-- 8. عدد الإدارات المخالفة -->
        <div id="card-comp-departments-count" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
            <div class="flex justify-between items-start mb-2">
                <span class="text-[11px] font-black text-slate-800" data-i18n="kpi-comp-departments-count">عدد الإدارات المخالفة</span>
                <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 border border-violet-200">سجل المخالفات</span>
            </div>
            <div class="my-2 flex flex-col items-center justify-center">
                <span class="text-3xl font-black text-slate-900" id="val-comp-departments-count">--</span>
            </div>
        </div>
    </div>

    <!-- Charts (live data only) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8 text-start" data-aos="fade-up">
        <!-- Actual vs target on the four indicators that have a target -->
        <div class="glass-card p-6 rounded-2xl lg:col-span-2">
            <h3 class="text-sm font-black text-slate-900 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-chart-bar text-[#b0841a]"></i>
                <span>الفعلي مقابل المستهدف</span>
            </h3>
            <div class="relative w-full h-80">
                <canvas id="compliance-chart-comparison"></canvas>
            </div>
        </div>
        <!-- Violations by severity -->
        <div class="glass-card p-6 rounded-2xl">
            <h3 class="text-sm font-black text-slate-900 mb-4" data-i18n="chart-compliance-distribution">توزيع المخالفات حسب الخطورة</h3>
            <div class="relative w-full h-80 flex items-center justify-center">
                <canvas id="complianceDistributionChart"></canvas>
            </div>
        </div>
    </div>
</div>
