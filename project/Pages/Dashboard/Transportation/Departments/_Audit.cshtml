@model project.Pages.IndexModel

<!-- Internal Audit Department KPI Cards -->
<div id="grid-audit" class="hidden">
    <!-- Card 1: Audit Plan Execution Rate -->
    <div id="card-audit-plan-execution" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-black text-slate-800" data-i18n="kpi-audit-plan-execution">نسبة تنفيذ خطة التدقيق</span>
            <span id="flag-audit-plan-execution" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-audit-plan-execution">--%</span>
            <span class="text-[9px] text-slate-500 font-bold mt-1">المستهدف: <span id="target-val-audit-plan-execution">90%</span></span>
        </div>
    </div>

    <!-- Card 2: Operational Compliance Rate -->
    <div id="card-operational-compliance-rate" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-black text-slate-800" data-i18n="kpi-operational-compliance-rate">نسبة الامتثال التشغيلي</span>
            <span id="flag-operational-compliance-rate" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-operational-compliance-rate">--%</span>
            <span class="text-[9px] text-slate-500 font-bold mt-1">المستهدف: <span id="target-val-operational-compliance-rate">95%</span></span>
        </div>
    </div>

    <!-- Card 3: Total Audited Processes -->
    <div id="card-total-audited-processes" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-black text-slate-800" data-i18n="kpi-total-audited-processes">إجمالي العمليات المفحوصة</span>
            <span id="flag-total-audited-processes" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-total-audited-processes">--</span>
            <span class="text-[9px] text-slate-500 font-bold mt-1">المستهدف: <span id="target-val-total-audited-processes">100</span></span>
        </div>
    </div>

    <!-- Card 4: Passed Processes Count -->
    <div id="card-passed-processes-count" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-black text-slate-800" data-i18n="kpi-passed-processes-count">العمليات السليمة والممتثلة</span>
            <span id="flag-passed-processes-count" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-passed-processes-count">--</span>
            <span class="text-[9px] text-slate-500 font-bold mt-1">المستهدف: <span id="target-val-passed-processes-count">95</span></span>
        </div>
    </div>

    <!-- Card 5: Critical Findings Count -->
    <div id="card-critical-findings-count" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-black text-slate-800" data-i18n="kpi-critical-findings-count">الملاحظات الحرجة المرصودة</span>
            <span id="flag-critical-findings-count" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-critical-findings-count">--</span>
            <span class="text-[9px] text-slate-500 font-bold mt-1">المستهدف: <span id="target-val-critical-findings-count">0</span></span>
        </div>
    </div>

    <!-- Card 6: Recommendations Count -->
    <div id="card-recommendations-count" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-black text-slate-800" data-i18n="kpi-recommendations-count">عدد التوصيات الصادرة</span>
            <span id="flag-recommendations-count" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-recommendations-count">--</span>
            <span class="text-[9px] text-slate-500 font-bold mt-1">المستهدف: <span id="target-val-recommendations-count">50</span></span>
        </div>
    </div>

    <!-- Card 7: Risk Mitigation Rate -->
    <div id="card-risk-mitigation-rate" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
        <div class="flex justify-between items-start mb-2">
            <span class="text-[10px] font-black text-slate-800" data-i18n="kpi-risk-mitigation-rate">معدل معالجة المخاطر التشغيلية</span>
            <span id="flag-risk-mitigation-rate" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
        </div>
        <div class="my-2 flex flex-col items-center justify-center">
            <span class="text-3xl font-black text-slate-900" id="val-risk-mitigation-rate">--%</span>
            <span class="text-[9px] text-slate-500 font-bold mt-1">المستهدف: <span id="target-val-risk-mitigation-rate">90%</span></span>
        </div>
    </div>
</div>
