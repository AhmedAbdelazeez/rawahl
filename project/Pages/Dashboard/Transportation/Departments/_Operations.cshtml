@model project.Pages.IndexModel

<!-- Operations Department KPI Cards (7 Live KPIs) -->
<!-- 1. Plan Adherence -->
<div id="card-ops-plan-adherence" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-ops-plan-adherence-title">الالتزام بالخطة التشغيلية</span>
        <span id="flag-ops-plan-adherence" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-ops-plan-adherence">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-ops-plan-adherence">--</span></span>
    </div>
</div>

<!-- 2. Fleet Utilization -->
<div id="card-ops-fleet-util" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-ops-fleet-util-title">معدل استغلال الأسطول</span>
        <span id="flag-ops-fleet-util" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-ops-fleet-util">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-ops-fleet-util">--</span></span>
    </div>
</div>

