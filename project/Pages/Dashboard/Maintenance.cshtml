@page
@model project.Pages.Dashboard.MaintenanceModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>إدارة الصيانة - شركة رواحل المشاعر</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { gold: { brand: '#b0841a', light: '#faf6ec', hover: '#ca9b29' } }
                }
            }
        }
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Tajawal', sans-serif; background: #f8f7f4; }
        .glass-card { background: #fff; border: 1px solid #eee; }
    </style>
</head>
<body class="text-slate-800">
    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-8 bg-white rounded-2xl p-5 border border-[#b0841a]/20">
            <div>
                <span class="bg-[#b0841a]/10 text-[#b0841a] text-[10px] px-3 py-1 rounded-full font-bold">إدارة الصيانة</span>
                <h1 class="text-xl font-black mt-2">مرحباً @Model.UserArabicDisplayName</h1>
                <p class="text-slate-500 text-xs font-semibold mt-1">أوامر الصيانة والأعطال ومؤشرات جاهزية الأسطول.</p>
            </div>
            <a href="/" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-xs font-black rounded-xl flex items-center gap-1.5">
                <i class="fa-solid fa-arrow-right"></i> العودة للرئيسية
            </a>
        </div>

        <!-- KPI Cards -->
        <div id="maint-kpi-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
            <div class="glass-card p-5 rounded-2xl"><span class="text-xs text-slate-500 font-bold">متوسط زمن الإصلاح (ساعة)</span><div class="text-2xl font-black mt-2" id="kpi-mttr">--</div></div>
            <div class="glass-card p-5 rounded-2xl"><span class="text-xs text-slate-500 font-bold">إجمالي الأعطال</span><div class="text-2xl font-black mt-2" id="kpi-breakdowns">--</div></div>
            <div class="glass-card p-5 rounded-2xl"><span class="text-xs text-slate-500 font-bold">جاهزية الأسطول %</span><div class="text-2xl font-black mt-2" id="kpi-availability">--</div></div>
            <div class="glass-card p-5 rounded-2xl"><span class="text-xs text-slate-500 font-bold">تكلفة قطع الغيار</span><div class="text-2xl font-black mt-2" id="kpi-parts-cost">--</div></div>
            <div class="glass-card p-5 rounded-2xl"><span class="text-xs text-slate-500 font-bold">نسبة الأعطال المتراكمة %</span><div class="text-2xl font-black mt-2" id="kpi-backlog">--</div></div>
            <div class="glass-card p-5 rounded-2xl"><span class="text-xs text-slate-500 font-bold">نسبة الأعطال النشطة %</span><div class="text-2xl font-black mt-2" id="kpi-active-rate">--</div></div>
        </div>

        <!-- Top Breakdown Locations -->
        <div class="glass-card p-5 rounded-2xl mb-8">
            <h3 class="text-sm font-black mb-3"><i class="fa-solid fa-location-dot text-[#b0841a]"></i> أكثر المواقع تكرارًا للأعطال (من تقارير الفروع)</h3>
            <div id="maint-locations-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <span class="text-xs text-slate-400 font-bold">جاري التحميل...</span>
            </div>
        </div>

        <!-- Filter -->
        <div class="glass-card p-5 rounded-2xl mb-4 flex flex-wrap gap-3 items-end">
            <div>
                <label class="text-[10px] font-bold text-slate-500 block mb-1">من تاريخ</label>
                <input type="date" id="maint-from" class="border border-slate-200 rounded-lg px-3 py-2 text-xs" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-500 block mb-1">إلى تاريخ</label>
                <input type="date" id="maint-to" class="border border-slate-200 rounded-lg px-3 py-2 text-xs" />
            </div>
            <button id="maint-filter-apply" class="bg-slate-800 hover:bg-slate-700 text-white text-xs font-black px-4 py-2 rounded-lg">تطبيق الفلتر</button>
            <button id="maint-filter-reset" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-4 py-2 rounded-lg">إعادة تعيين</button>
        </div>

        <!-- Table -->
        <div class="glass-card rounded-2xl overflow-hidden">
            <table class="w-full text-xs">
                <thead class="bg-slate-50 text-slate-500 font-black">
                    <tr>
                        <td class="p-3">رقم اللوحة</td>
                        <td class="p-3">التاريخ</td>
                        <td class="p-3">العداد</td>
                        <td class="p-3">وصف العطل</td>
                        <td class="p-3">الفني</td>
                        <td class="p-3">الحالة</td>
                    </tr>
                </thead>
                <tbody id="maint-table-body"></tbody>
            </table>
            <div class="flex justify-between items-center p-4 border-t border-slate-100">
                <span class="text-xs font-bold text-slate-500" id="maint-page-info">--</span>
                <div class="flex gap-2">
                    <button id="maint-prev" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-3 py-1.5 rounded-lg">السابق</button>
                    <button id="maint-next" class="bg-slate-100 hover:bg-slate-200 text-xs font-black px-3 py-1.5 rounded-lg">التالي</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/dashboard/maintenance-landing.js" asp-append-version="true"></script>
</body>
</html>
