@model project.Pages.IndexModel

<!-- ================= شريط أخبار الـ KPIs اللانهائي =================
     Every item is built by updateTickerWithPortalData() (portal-integration.js) from the live KPI
     endpoints, and rebuilt on each auto-refresh. Nothing here is hard-coded: an item only appears
     once its department actually has data. The two tracks are always written with identical
     content - the loop animation slides the container by exactly half its width, which is only
     seamless when both halves match. -->
<div class="ticker-wrap py-4 text-sm font-black">
    <div class="ticker-container" id="ticker-container">
        <div class="ticker" id="ticker-track">
            <div class="ticker__item">
                <span class="text-gold-brand"><i class="fa-solid fa-circle-notch fa-spin me-1.5"></i> جاري تحميل المؤشرات الحية...</span>
            </div>
        </div>
        <div class="ticker" id="ticker-track-dup" aria-hidden="true">
            <div class="ticker__item">
                <span class="text-gold-brand"><i class="fa-solid fa-circle-notch fa-spin me-1.5"></i> جاري تحميل المؤشرات الحية...</span>
            </div>
        </div>
    </div>
</div>
