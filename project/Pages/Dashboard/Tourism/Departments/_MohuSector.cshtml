@model project.Pages.IndexModel

<!-- ================= التطبيق الكلي لنظام المعايير الجديدة لوزارة الحج والعمرة (MOHU New Standards View) ================= -->
<div id="view-dept-mohu-standards" class="view-container hidden">
    <section class="mb-6" data-aos="fade-up">
        <div class="bg-white rounded-3xl p-6 text-slate-800 border border-[#b0841a]/30 relative overflow-hidden">
            <div class="absolute -right-24 -top-24 w-64 h-64 bg-[#b0841a]/5 rounded-full blur-3xl"></div>
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 relative z-10 text-start">
                <div>
                    <span class="bg-[#b0841a]/10 text-[#b0841a] text-[10px] px-3.5 py-1.5 rounded-full font-bold border border-[#b0841a]/20">التطبيق الكلي لنظام المعايير الجديدة</span>
                    <h2 class="text-lg font-black mt-2 text-slate-800">معايير وزارة الحج والعمرة</h2>
                    <p class="text-slate-500 text-xs leading-relaxed font-semibold mt-1">بوابة المراقبة والتحليل لامتثال الشركة لمعايير نظام وزارة الحج والعمرة للخدمات والعمليات.</p>
                </div>
                <button onclick="showView('pilgrim-sector')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-black rounded-xl text-slate-800 flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-arrow-right"></i>
                    <span>العودة للخدمات</span>
                </button>
            </div>
        </div>
    </section>

    <!-- 4 Grouped Categories Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8 text-start" data-aos="fade-up">
        
        <!-- تنوع المعتمرين -->
        <div onclick="showView('service-mohu-diversity')" class="glass-card p-6 rounded-2xl cursor-pointer flex flex-col justify-between h-48 group bg-white hover:border-[#b0841a]">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-sm font-black text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-users text-[#b0841a] text-lg"></i>
                        <span>تنوع المعتمرين</span>
                    </h3>
                    <p class="text-[10px] text-slate-500 font-semibold mt-2 leading-relaxed">يعكس مدى التزام الشركة بتقديم عروض تلائم شرائح سعرية متنوعة توافق فئاتها.</p>
                </div>
                <span class="w-8 h-8 rounded-full bg-[#b0841a]/10 text-[#b0841a] flex items-center justify-center text-xs font-bold shrink-0 shadow-inner group-hover:bg-[#b0841a] group-hover:text-white transition-colors"><i class="fa-solid fa-arrow-left ltr:rotate-180"></i></span>
            </div>
            <div class="mt-4 flex justify-between items-end border-t border-slate-100 pt-3">
                <span class="text-[9px] text-[#b0841a] font-black">الوزن المخصص: 15%</span>
                <span class="text-[9px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-black border border-slate-200">DIVERSITY</span>
            </div>
        </div>

        <!-- تجربة المعتمر وجودة الخدمة -->
        <div onclick="showView('service-mohu-experience')" class="glass-card p-6 rounded-2xl cursor-pointer flex flex-col justify-between h-48 group bg-white hover:border-[#b0841a]">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-sm font-black text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-star text-[#b0841a] text-lg"></i>
                        <span>تجربة المعتمر وجودة الخدمة</span>
                    </h3>
                    <p class="text-[10px] text-slate-500 font-semibold mt-2 leading-relaxed">يعكس رضا المعتمرين عن الخدمات المقدمة وجودتها، بما يشمل التفاعل معهم ومعالجة الشكاوى.</p>
                </div>
                <span class="w-8 h-8 rounded-full bg-[#b0841a]/10 text-[#b0841a] flex items-center justify-center text-xs font-bold shrink-0 shadow-inner group-hover:bg-[#b0841a] group-hover:text-white transition-colors"><i class="fa-solid fa-arrow-left ltr:rotate-180"></i></span>
            </div>
            <div class="mt-4 flex justify-between items-end border-t border-slate-100 pt-3">
                <span class="text-[9px] text-[#b0841a] font-black">الوزن المخصص: 35%</span>
                <span class="text-[9px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-black border border-slate-200">EXPERIENCE</span>
            </div>
        </div>

        <!-- الامتثال -->
        <div onclick="showView('service-mohu-compliance')" class="glass-card p-6 rounded-2xl cursor-pointer flex flex-col justify-between h-48 group bg-white hover:border-[#b0841a]">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-sm font-black text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-shield-check text-[#b0841a] text-lg"></i>
                        <span>الامتثال</span>
                    </h3>
                    <p class="text-[10px] text-slate-500 font-semibold mt-2 leading-relaxed">يقيس مدى التزام الشركات بالتعليمات والأنظمة ومستوى التعاون مع الوزارة في الاستجابات والتنظيم.</p>
                </div>
                <span class="w-8 h-8 rounded-full bg-[#b0841a]/10 text-[#b0841a] flex items-center justify-center text-xs font-bold shrink-0 shadow-inner group-hover:bg-[#b0841a] group-hover:text-white transition-colors"><i class="fa-solid fa-arrow-left ltr:rotate-180"></i></span>
            </div>
            <div class="mt-4 flex justify-between items-end border-t border-slate-100 pt-3">
                <span class="text-[9px] text-[#b0841a] font-black">الوزن المخصص: 25%</span>
                <span class="text-[9px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-black border border-slate-200">COMPLIANCE</span>
            </div>
        </div>

        <!-- جودة البيانات -->
        <div onclick="showView('service-mohu-data')" class="glass-card p-6 rounded-2xl cursor-pointer flex flex-col justify-between h-48 group bg-white hover:border-[#b0841a]">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-sm font-black text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-database text-[#b0841a] text-lg"></i>
                        <span>جودة البيانات</span>
                    </h3>
                    <p class="text-[10px] text-slate-500 font-semibold mt-2 leading-relaxed">يقيس مدى تطابق البيانات المسجلة من قبل الشركة مع البيانات المعتمدة من الجهات الحكومية.</p>
                </div>
                <span class="w-8 h-8 rounded-full bg-[#b0841a]/10 text-[#b0841a] flex items-center justify-center text-xs font-bold shrink-0 shadow-inner group-hover:bg-[#b0841a] group-hover:text-white transition-colors"><i class="fa-solid fa-arrow-left ltr:rotate-180"></i></span>
            </div>
            <div class="mt-4 flex justify-between items-end border-t border-slate-100 pt-3">
                <span class="text-[9px] text-[#b0841a] font-black">الوزن المخصص: 25%</span>
                <span class="text-[9px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-black border border-slate-200">DATA QUALITY</span>
            </div>
        </div>

    </section>
</div>
