@model project.Pages.IndexModel

<!-- Tourism Department KPI Cards (7 Live KPIs) -->
<!-- 1. Hotel Occupancy -->
<div id="card-tourism-hotel-occupancy" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-tourism-hotel-occupancy-title">نسبة إشغال الفنادق</span>
        <span id="flag-tourism-hotel-occupancy" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-tourism-hotel-occupancy">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-tourism-hotel-occupancy">--</span></span>
    </div>
</div>

<!-- 2. Booking Cancel Rate -->
<div id="card-tourism-cancel-rate" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-tourism-cancel-rate-title">معدل إلغاء الحجوزات</span>
        <span id="flag-tourism-cancel-rate" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-tourism-cancel-rate">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-tourism-cancel-rate">--</span></span>
    </div>
</div>

<!-- 3. Guest Rating -->
<div id="card-tourism-guest-rating" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-tourism-guest-rating-title">تقييم رضا النزلاء</span>
        <span id="flag-tourism-guest-rating" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-tourism-guest-rating">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-tourism-guest-rating">--</span></span>
    </div>
</div>

<!-- 4. Tours Completed -->
<div id="card-tourism-tours-completed" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-tourism-tours-completed-title">الرحلات السياحية المنفذة</span>
        <span id="flag-tourism-tours-completed" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-tourism-tours-completed">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-tourism-tours-completed">--</span></span>
    </div>
</div>

<!-- 5. RevPAR -->
<div id="card-tourism-revpar" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-tourism-revpar-title">متوسط إيراد الغرفة المتاحة</span>
        <span id="flag-tourism-revpar" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-tourism-revpar">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-tourism-revpar">--</span></span>
    </div>
</div>

<!-- 6. Booking Lead Time -->
<div id="card-tourism-lead-time" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-tourism-lead-time-title">زمن معالجة الحجوزات</span>
        <span id="flag-tourism-lead-time" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-tourism-lead-time">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-tourism-lead-time">--</span></span>
    </div>
</div>

<!-- 7. Active Tour Guides -->
<div id="card-tourism-active-guides" class="glass-card p-5 rounded-2xl flex flex-col justify-between h-40">
    <div class="flex justify-between items-start mb-2">
        <span class="text-[11px] font-black text-slate-800" data-i18n="card-tourism-active-guides-title">المرشدين السياحيين النشطين</span>
        <span id="flag-tourism-active-guides" class="text-[9px] font-bold px-2 py-0.5 rounded-full">--</span>
    </div>
    <div class="my-2 flex flex-col items-center justify-center">
        <span class="text-3xl font-black text-slate-900" id="val-tourism-active-guides">--</span>
        <span class="text-[10px] text-slate-500 font-bold mt-1.5">المستهدف: <span id="target-val-tourism-active-guides">--</span></span>
    </div>
</div>
