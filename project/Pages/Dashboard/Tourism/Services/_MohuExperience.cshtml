<!-- CRUD SECTION -->
<div id="card-mohu-exp-crud" class="col-span-1 sm:col-span-2 lg:col-span-3 xl:col-span-4 glass-card p-6 rounded-2xl mt-4">
    <div class="flex justify-between items-center mb-4">
        <h3 class="text-sm font-black text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-edit text-[#b0841a]"></i> إدارة بيانات مؤشرات تجربة المعتمر وجودة الخدمة
        </h3>
        <button class="bg-[#b0841a] text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-[#8c6510] transition-colors shadow-sm flex items-center gap-2">
            <i class="fa-solid fa-plus"></i> إضافة بيان جديد
        </button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-start border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="p-3 text-xs font-bold text-slate-500 text-start">رقم المؤشر</th>
                    <th class="p-3 text-xs font-bold text-slate-500 text-start">اسم المؤشر</th>
                    <th class="p-3 text-xs font-bold text-slate-500 text-start">القيمة الفعلية</th>
                    <th class="p-3 text-xs font-bold text-slate-500 text-start">المستهدف</th>
                    <th class="p-3 text-xs font-bold text-slate-500 text-center">الإجراءات (CRUD)</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                    <td class="p-3 text-xs font-semibold text-slate-800">M-EXP-01</td>
                    <td class="p-3 text-xs font-semibold text-slate-800">رضا المعتمرين</td>
                    <td class="p-3 text-xs font-black text-slate-900">92%</td>
                    <td class="p-3 text-xs font-bold text-slate-500">90%</td>
                    <td class="p-3 text-center flex justify-center gap-2">
                        <button class="text-blue-500 hover:text-blue-700 bg-blue-50 p-2 rounded-md"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="text-rose-500 hover:text-rose-700 bg-rose-50 p-2 rounded-md"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

